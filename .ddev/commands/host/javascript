#!/bin/bash

## Description: compiles ts to js, runs linter with auto-fix, then recompiles
## Usage: javascript
## Example: ddev javascript


cd Build

echo "==> Running ESLint --fix on content-blocks-gui sources..."
npx eslint --fix "Sources/TypeScript/friendsoftypo3/**/*.ts" 2>&1 || true

echo ""
echo "==> Compiling TypeScript..."
node_modules/grunt/bin/grunt clear-build && node_modules/grunt/bin/grunt scripts

cd ..

cp -r Build/JavaScript/friendsoftypo3/content-blocks-gui packages/content_blocks_gui/Resources/Public/JavaScript

ddev typo3 cache:flush
